{
  "name": "@jcy2387/dsh-dungeon-party",
  "version": "0.1.12",
  "description": "DSH five-agent dungeon party orchestration plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DamonBao/dsh-dungeon-party.git"
  },
  "homepage": "https://github.com/DamonBao/dsh-dungeon-party#readme",
  "bugs": {
    "url": "https://github.com/DamonBao/dsh-dungeon-party/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./lib/preset-sync.js",
  "types": "./lib/types/preset-sync.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/preset-sync.d.ts",
      "default": "./lib/preset-sync.js"
    },
    "./runtime": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./preset-sync": {
      "types": "./lib/types/preset-sync.d.ts",
      "default": "./lib/preset-sync.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.zh-CN.md",
    "lib/**",
    "preset/**",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:client",
    "build:client": "npm run build:client:types && tsdown",
    "build:client:types": "tsdown --config tsdown.client-types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-client-store": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-session-projection": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-subagent": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-jobs": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-sandbox": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-projection-cache": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-util-time": "0.1.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/react-test-renderer": "^18.3.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.9.1",
    "js-yaml": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "tsdown": "^0.15.10",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshClient": {
    "inject": [
      "@deepseek-ai/dsh-client-ui-layout",
      "@deepseek-ai/dsh-client-ui-renderer",
      "@deepseek-ai/dsh-client-ui-session"
    ],
    "platform": "web"
  }
}
